# ЮKassa — тестовый или боевой магазин.
# Получить: личный кабинет ЮKassa → Настройки → API-ключи.
# Тестовый режим включается переключателем в личном кабинете и не требует
# реальных платежей для проверки чекаута.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# Порт backend-сервера
PORT=3001

# Адрес фронтенда — сюда ЮKassa вернёт покупателя после оплаты
FRONTEND_URL=http://localhost:5173

# Публичный адрес CRM. Vite подставляет его в кнопку «Открыть CRM» в /admin.
# Если не указан, используется https://crm.satorilabural.ru
VITE_CRM_URL=https://crm.satorilabural.ru

# Пароль для входа в админку (/admin) и Satori CRM
ADMIN_PASSWORD=

# OAuth-токен Яндекса с правом metrika:offline_data (oauth.yandex.ru) —
# нужен для серверной подстраховки: догружает конверсию "Заказ оплачен" в
# Метрику через offline_conversions API, если клиентский reachGoal() не
# успел сработать (браузер закрыт и т.п.). Необязательно — без токена этот
# путь просто не используется, клиентское отслеживание работает как раньше.
YANDEX_METRIKA_TOKEN=

# Уведомления о новых заявках/заказах в VK (сообщение от группы владельцу).
# Необязательно — без них уведомления просто не отправляются.
# VK_GROUP_TOKEN — токен сообщества с правом messages (vk.com/apps?act=manage).
# VK_GROUP_ID — числовой ID сообщества.
# ADMIN_VK_HANDLE — короткое имя или ID страницы, куда слать уведомления.
VK_GROUP_TOKEN=
VK_GROUP_ID=
ADMIN_VK_HANDLE=

# ── Satori CRM / AI sales manager ────────────────────────────────────────────
# Ключ OpenAI хранится только на сервере. Без него AI-менеджер остаётся
# выключенным, но история парсинга и контакты продолжают работать.
OPENAI_API_KEY=
AI_MANAGER_MODEL=gpt-5.6-luna
AI_MANAGER_TIMEZONE=Europe/Moscow
AI_MANAGER_START_HOUR=10
AI_MANAGER_END_HOUR=19
AI_MANAGER_DAILY_LIMIT=20
AI_MANAGER_MAX_TOUCHES=3
AI_MANAGER_POLL_MS=20000

# Для полностью автоматического первого холодного WhatsApp-сообщения нужен
# заранее одобренный Meta template. Без template AI подготовит черновик,
# а первый контакт можно запустить вручную из CRM.
WHATSAPP_OUTREACH_TEMPLATE_NAME=
WHATSAPP_FOLLOWUP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=ru