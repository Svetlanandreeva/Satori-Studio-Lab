# ЮKassa — тестовый или боевой магазин.
# Получить: личный кабинет ЮKassa → Настройки → API-ключи.
# Тестовый режим включается переключателем в личном кабинете и не требует
# реальных платежей для проверки чекаута.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# Порт backend-сервера
PORT=3001

# Адрес фронтенда — сюда ЮKassa вернёт покупателя после оплаты
FRONTEND_URL=http://localhost:5173

# Пароль для входа в админку (/admin)
ADMIN_PASSWORD=

# OAuth-токен Яндекса с правом metrika:offline_data (oauth.yandex.ru) —
# нужен для серверной подстраховки: догружает конверсию "Заказ оплачен" в
# Метрику через offline_conversions API, если клиентский reachGoal() не
# успел сработать (браузер закрыт и т.п.). Необязательно — без токена этот
# путь просто не используется, клиентское отслеживание работает как раньше.
YANDEX_METRIKA_TOKEN=

# Уведомления о новых заявках/заказах в VK (сообщение от группы владельцу).
# Необязательно — без них уведомления просто не отправляются.
# VK_GROUP_TOKEN — токен сообщества с правом messages (vk.com/apps?act=manage).
# VK_GROUP_ID — числовой ID сообщества.
# ADMIN_VK_HANDLE — короткое имя или ID страницы, куда слать уведомления.
VK_GROUP_TOKEN=
VK_GROUP_ID=
ADMIN_VK_HANDLE=
